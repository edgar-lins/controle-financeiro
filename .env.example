# Copie este arquivo para .env e preencha os valores
# cp .env.example .env

# ─── Ambiente ────────────────────────────────────────────
ENVIRONMENT=development   # development | production

# ─── Banco de Dados ──────────────────────────────────────
# Desenvolvimento (variáveis individuais)
DB_HOST=localhost
DB_PORT=5432
DB_USER=seu_usuario
DB_PASSWORD=sua_senha
DB_NAME=controle_financeiro

# Produção (Render/Railway fornecem DATABASE_URL diretamente)
# DATABASE_URL=postgresql://usuario:senha@host:porta/dbname

# ─── Servidor ────────────────────────────────────────────
PORT=8080

# ─── Autenticação JWT ────────────────────────────────────
# Gere uma chave forte: openssl rand -hex 32
JWT_SECRET=troque-por-uma-chave-forte-em-producao

# ─── CORS ────────────────────────────────────────────────
# Separe múltiplas origens por vírgula
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Email (Resend) ──────────────────────────────────────
# Crie sua conta em resend.com e gere uma API key
# Sem essa variável, o link de reset de senha aparece no console (modo dev)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Endereço de envio (domínio verificado no Resend)
# Em teste, use: onboarding@resend.dev
RESEND_FROM_EMAIL=noreply@seudominio.com

# URL pública do frontend (usada no link do email de reset de senha)
APP_URL=https://seuapp.vercel.app
